# --- Required ---

# Anthropic API key (https://platform.claude.com). Used server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Password for the /admin control room. Pick something long and random.
ADMIN_PASSWORD=change-me

# --- Optional ---

# Override the SQLite file location. Defaults to ./data/satoshi.db locally,
# /tmp/satoshi.db on Vercel (ephemeral — see README "Deploying" section).
# DB_PATH=/var/data/satoshi.db

# Rehearsal mode: when "1", the analyst is simulated deterministically with no
# API calls — full pipeline (streaming, leaderboard, synthesis) runs offline.
# Use it to practice the run-of-show without spending tokens. NEVER leave this
# on for the live show.
# REHEARSAL_MODE=0
